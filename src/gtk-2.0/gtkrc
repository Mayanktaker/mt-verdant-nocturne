gtk-color-scheme = "base_color:{{bg.tile}}\nbg_color:{{bg.base}}\ntext_color:{{text.primary}}\nfg_color:{{text.primary}}\nselected_bg_color:{{accent.base}}\nselected_fg_color:{{accent.text_on_accent}}\ntooltip_bg_color:{{bg.surface}}\ntooltip_fg_color:{{text.primary}}"

style "default" {
  xthickness = 1
  ythickness = 1

  GtkButton::child-displacement-x = 1
  GtkButton::child-displacement-y = 1
  GtkButton::default-border = { 0, 0, 0, 0 }
  GtkRange::trough-border = 0
  GtkRange::slider-width = 12

  bg[NORMAL]        = "{{bg.base}}"
  bg[ACTIVE]        = "{{bg.surface}}"
  bg[PRELIGHT]      = "{{bg.surface}}"
  bg[SELECTED]      = "{{accent.base}}"
  bg[INSENSITIVE]   = "{{bg.base_darker}}"

  base[NORMAL]      = "{{bg.tile}}"
  base[ACTIVE]      = "{{bg.surface}}"
  base[PRELIGHT]    = "{{bg.surface}}"
  base[SELECTED]    = "{{accent.base}}"
  base[INSENSITIVE] = "{{bg.base}}"

  fg[NORMAL]        = "{{text.primary}}"
  fg[ACTIVE]        = "{{text.primary}}"
  fg[PRELIGHT]      = "{{text.primary}}"
  fg[SELECTED]      = "{{accent.text_on_accent}}"
  fg[INSENSITIVE]   = "{{text.disabled}}"

  text[NORMAL]      = "{{text.primary}}"
  text[ACTIVE]      = "{{text.primary}}"
  text[PRELIGHT]    = "{{text.primary}}"
  text[SELECTED]    = "{{accent.text_on_accent}}"
  text[INSENSITIVE] = "{{text.disabled}}"
}

style "button" = "default" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL]   = "{{bg.tile}}"
  bg[PRELIGHT] = "{{bg.surface}}"
  bg[ACTIVE]   = "{{accent.base}}"
  fg[ACTIVE]   = "{{accent.text_on_accent}}"
}

style "entry" = "default" {
  xthickness = 3
  ythickness = 3
  base[NORMAL] = "{{bg.tile}}"
}

style "menu" = "default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL]   = "{{bg.tile}}"
  bg[PRELIGHT] = "{{accent.base}}"
  fg[PRELIGHT] = "{{accent.text_on_accent}}"
}

style "menubar" = "default" {
  bg[NORMAL]   = "{{bg.base}}"
}

style "tooltip" {
  xthickness = 4
  ythickness = 4
  bg[NORMAL]   = "{{bg.surface}}"
  fg[NORMAL]   = "{{text.primary}}"
}

class "GtkWidget" style "default"
class "GtkButton" style "button"
class "GtkEntry" style "entry"
class "GtkMenu" style "menu"
class "GtkMenuBar" style "menubar"
widget "gtk-tooltip*" style "tooltip"
